[Unit]
Description=Linux Health Monitoring Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=monitorapp
Group=monitorapp
WorkingDirectory=/opt/linux-health-monitor
ExecStart=/usr/bin/java -jar /opt/linux-health-monitor/app.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
Environment=PORT=8080
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/linux-health-monitor

[Install]
WantedBy=multi-user.target
